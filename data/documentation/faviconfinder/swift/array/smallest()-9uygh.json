{"variants":[{"paths":["\/documentation\/faviconfinder\/swift\/array\/smallest()-9uygh"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Will iterate over each "},{"type":"codeVoice","code":"FaviconURL"},{"type":"text","text":" and analyse the "},{"type":"codeVoice","code":"inferredSize"},{"type":"text","text":", and returns"},{"type":"text","text":" "},{"type":"text","text":"the smallest one."}],"hierarchy":{"paths":[["doc:\/\/FaviconFinder\/documentation\/FaviconFinder","doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/Swift","doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/Swift\/Array"]]},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"smallest"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"FaviconURL","identifier":"doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/FaviconURL","preciseIdentifier":"s:13FaviconFinder0A3URLV"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"FaviconURL"},{"type":"text","text":" from the array of "},{"type":"codeVoice","code":"FaviconURL"},{"type":"text","text":"s that we deem to be the smallest."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Notably, calling ","type":"text"},{"type":"codeVoice","code":"smallest()"},{"text":" on an array of ","type":"text"},{"type":"codeVoice","code":"FaviconURL"},{"text":" instead of on an array of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Favicon"},{"text":" means yo