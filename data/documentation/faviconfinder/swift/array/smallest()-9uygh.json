ue","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"FaviconURL","type":"codeVoice"},{"text":" from the array of ","type":"text"},{"code":"FaviconURL","type":"codeVoice"},{"text":"s that we deem to be the smallest.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Notably, calling ","type":"text"},{"code":"smallest()","type":"codeVoice"},{"text":" on an array of ","type":"text"},{"code":"FaviconURL","type":"codeVoice"},{"text":" instead of on an array of","type":"text"},{"text":" ","type":"text"},{"code":"Favicon","type":"codeVoice"},{"text":" means you can extrapolate the smallest image without having to download all of them.","type":"text"},{"text":" ","type":"text"},{"text":"This comes with the drawbacks of","type":"text"},{"text":" ","type":"text"},{"text":"1. Only being able to use this function appropriately if the source has set the sizeTags, either in the","type":"text"},{"text":" ","type":"text"},{"text":"HTML or the WebApplicationManifestFile.","type":"text"},{"text":" ","type":"text"},{"text":"2. Not being 100% certain, as the size in the sizeTags and the actual true size may be different due","type":"text"},{"text":" ","type":"text"},{"text":"to the source being configured incorrectly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"However there are plently of use cases where these drawbacks are worth it to get the smallest image without","type":"text"},{"text":" ","type":"text"},{"text":"having to download them all, so here we are.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/FaviconFinder\/documentation\/FaviconFinder","doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/Swift","doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/Swift\/Array"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/faviconfinder\/sw