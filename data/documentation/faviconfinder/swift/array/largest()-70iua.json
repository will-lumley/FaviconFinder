xt":"2. Not being 100% certain, as the size in the sizeTags and the actual true size may be different due"},{"type":"text","text":" "},{"type":"text","text":"to the source being configured incorrectly."}]},{"type":"paragraph","inlineContent":[{"text":"However there are plently of use cases where these drawbacks are worth it to get the largest image without","type":"text"},{"text":" ","type":"text"},{"text":"having to download them all, so here we are.","type":"text"}]}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/faviconfinder\/swift\/array\/largest()-70iua"]}],"metadata":{"title":"largest()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"largest"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"FaviconURL","preciseIdentifier":"s:13FaviconFinder0A3URLV"}],"role":"symbol","extendedModule":"Swift","roleHeading":"Instance Method","externalID":"s:Sa13FaviconFinderAA0A3URLVRszlE7largestACyYaKF","symbolKind":"method","modules":[{"relatedModules":["Swift"],"name":"FaviconFinder"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"FaviconURL"},{"type":"text","text":"."}]}},"kind":"symbol","abstract":[{"type":"text","text":"Will iterate over each "},{"code":"FaviconURL","type":"codeVoice"},{"type":"text","text":" and analyse the "},{"code":"inferredSize","type":"codeVoice"},{"type":"text","text":", and returns"},{"type":"text","text":" "},{"type":"text","text":"the largest one."}],"hierarchy":{"paths":[["doc:\/\/FaviconFinder\/documentation\/FaviconFinder","doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/Swift","doc:\/\/FaviconFin