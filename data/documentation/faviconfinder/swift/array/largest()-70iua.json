{"abstract":[{"type":"text","text":"Will iterate over each "},{"type":"codeVoice","code":"FaviconURL"},{"type":"text","text":" and analyse the "},{"type":"codeVoice","code":"inferredSize"},{"type":"text","text":", and returns"},{"type":"text","text":" "},{"type":"text","text":"the largest one."}],"variants":[{"paths":["\/documentation\/faviconfinder\/swift\/array\/largest()-70iua"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"largest"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13FaviconFinder0A3URLV","identifier":"doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/FaviconURL","text":"FaviconURL"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"FaviconURL","type":"codeVoice"},{"text":" from the array of ","type":"text"},{"code":"FaviconURL","type":"codeVoice"},{"text":"s that we deem to be the largest.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Notably, calling "},{"type":"codeVoice","code":"largest()"},{"type":"text","text":" on an array of "},{"type":"codeVoice","code":"FaviconURL"},{"type":"text","text":" instead of on an array of"},{"type":"text","text":" "},{"type":"codeVoice","code":"Favicon"},{"type":"text","text":" means you can extrapolate the largest image without having to download all of them."},{"type":"text","text":" "},{"type":"text","text":"This comes with the drawbacks of"},{"type":"text","text":" "},{"type":"text","text":"1. Only being able to use this fun