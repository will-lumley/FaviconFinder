":"text","text":" "},{"type":"text","text":"the TLD. This means any single- or compound-TLD URL is supported without a hardcoded list."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Example:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["URL(string: \"https:\/\/mail.google.com\")!.urlWithoutSubdomains   \/\/ https:\/\/google.com","URL(string: \"https:\/\/mail.google.co.uk\")!.urlWithoutSubdomains \/\/ https:\/\/google.co.uk","URL(string: \"https:\/\/sub.example.io\")!.urlWithoutSubdomains    \/\/ https:\/\/example.io"]}]}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/Foundation\/URL\/urlWithoutSubdomains"},"metadata":{"externalID":"s:10Foundation3URLV13FaviconFinderE20urlWithoutSubdomainsACSgvp","title":"urlWithoutSubdomains","symbolKind":"property","modules":[{"name":"FaviconFinder","relatedModules":["Foundation"]}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"urlWithoutSubdomains","kind":"identifier"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":"?","kind":"text"}],"extendedModule":"Foundation","role":"symbol","roleHeading":"Instance Property"},"references":{"doc://FaviconFinder/documentation/FaviconFinder/Foundation":{"title":"Foundation","kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/faviconfinder\/foundation","identifier":"doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/Foundation","type":"topic"},"doc://FaviconFinder/documentation/FaviconFinder":{"kind":"symbol","identifier":"doc:\/\/FaviconFinder\/documentation\/FaviconFinder","type":"topic","title":"FaviconFinder","url":"\/documentation\/faviconfinder","abstract":[],"role":"collection"},"doc://FaviconFinder/documentation/FaviconFinder/Foundation/URL/urlWithoutSubdomains":{"title":"